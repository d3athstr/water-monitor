---
# Copy to secrets.yaml and fill in. secrets.yaml is gitignored.
wifi_ssid: "IOT-SSID"
wifi_password: "REPLACE_ME"
fallback_password: "REPLACE_ME"
api_encryption_key: "GENERATE_WITH: openssl rand -base64 32"
ota_password: "REPLACE_ME"

# Static addressing on the IoT VLAN.
static_ip: "10.0.0.60"
gateway: "10.0.0.1"
dns1: "10.0.0.53"
